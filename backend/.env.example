# Firebase Admin SDK
FIREBASE_ADMIN_SDK_PATH=firebase-admin-sdk.json

# Database
DATABASE_URL=sqlite:///./neurolens.db

# API Settings
API_V1_STR=/api
PROJECT_NAME=NeuroLens API
LOG_LEVEL=INFO

# CORS (comma-separated list or JSON array)
# Example: http://localhost:8081,http://127.0.0.1:8081
BACKEND_CORS_ORIGINS=*

# Optional remote model endpoint
MODEL_SERVER_URL=https://haran29-neurolenseapp.hf.space/
